{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elias:lilp:schema:chain-continuity:v0.1",
  "title": "ELIAS LILP Chain Continuity Object v0.1",
  "description": "Working reference structural schema for evaluating whether a successor object can remain within an existing governance chain or requires a new chain.",
  "type": "object",
  "x-elias-document-id": "ELIAS-LILP-SCHEMA-001",
  "x-elias-object": "CHAIN_CONTINUITY",
  "x-elias-schema-version": "v0.1",
  "x-elias-ancestors": {
    "std001_sha256": "076EE05F6441EA1A41F30006614AB0343E66E809A000B7509BDFF0CF729F5537",
    "man001_sha256": "429BD91C06933FD21068C51D64ECE4D299C5B33A9F22DA1E2F3572302EADBEB2",
    "lex001_sha256": "144EFB9CAAB7A0F0537A84704626AC58C5659A0B50F92AA64086B07918E63488"
  },
  "x-elias-authority-boundary": "Historical continuity must not be invented. Where required continuity cannot be established, NEW_CHAIN_REQUIRED or NOT_ESTABLISHED remains admissible.",
  "properties": {
    "object_type": {
      "const": "CHAIN_CONTINUITY"
    },
    "schema_id": {
      "const": "urn:elias:lilp:schema:chain-continuity:v0.1"
    },
    "schema_version": {
      "const": "v0.1"
    },
    "continuity_id": {
      "type": "string",
      "minLength": 1
    },
    "chain_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_reference": {
      "type": "string",
      "minLength": 1
    },
    "predecessor_reference": {
      "type": "string",
      "minLength": 1
    },
    "predecessor_hash": {
      "type": "string",
      "minLength": 1
    },
    "successor_reference": {
      "type": "string",
      "minLength": 1
    },
    "successor_hash": {
      "type": "string",
      "minLength": 1
    },
    "delta_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "identity_continuity": {
      "enum": [
        "ESTABLISHED",
        "FAILED",
        "NOT_ESTABLISHED"
      ]
    },
    "authority_continuity": {
      "enum": [
        "ESTABLISHED",
        "FAILED",
        "NOT_ESTABLISHED"
      ]
    },
    "state_continuity": {
      "enum": [
        "ESTABLISHED",
        "FAILED",
        "NOT_ESTABLISHED"
      ]
    },
    "continuity_status": {
      "enum": [
        "ESTABLISHED",
        "FAILED",
        "NOT_ESTABLISHED",
        "NEW_CHAIN_REQUIRED"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "canonicalisation_profile": {
      "type": "string",
      "minLength": 1
    },
    "hash_algorithm": {
      "type": "string",
      "minLength": 1
    },
    "continuity_hash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "continuity_id",
    "chain_id",
    "origin_reference",
    "predecessor_reference",
    "predecessor_hash",
    "successor_reference",
    "successor_hash",
    "delta_references",
    "identity_continuity",
    "authority_continuity",
    "state_continuity",
    "continuity_status",
    "reason_codes",
    "evaluated_at",
    "evidence_references",
    "claim_ceiling",
    "provenance"
  ],
  "additionalProperties": true
}