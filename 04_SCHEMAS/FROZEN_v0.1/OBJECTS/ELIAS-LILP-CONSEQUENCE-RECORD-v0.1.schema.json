{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elias:lilp:schema:consequence-record:v0.1",
  "title": "ELIAS LILP Consequence Record v0.1",
  "description": "Working reference structural schema for observed or not-yet-established consequence following an execution record.",
  "type": "object",
  "x-elias-document-id": "ELIAS-LILP-SCHEMA-001",
  "x-elias-object": "CONSEQUENCE_RECORD",
  "x-elias-schema-version": "v0.1",
  "x-elias-ancestors": {
    "std001_sha256": "076EE05F6441EA1A41F30006614AB0343E66E809A000B7509BDFF0CF729F5537",
    "man001_sha256": "429BD91C06933FD21068C51D64ECE4D299C5B33A9F22DA1E2F3572302EADBEB2",
    "lex001_sha256": "144EFB9CAAB7A0F0537A84704626AC58C5659A0B50F92AA64086B07918E63488"
  },
  "x-elias-authority-boundary": "Execution attempt does not equal completed consequence. Consequence claims must stop at observed evidence.",
  "properties": {
    "object_type": {
      "const": "CONSEQUENCE_RECORD"
    },
    "schema_id": {
      "const": "urn:elias:lilp:schema:consequence-record:v0.1"
    },
    "schema_version": {
      "const": "v0.1"
    },
    "consequence_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_reference": {
      "type": "string",
      "minLength": 1
    },
    "contemplated_effect": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      ]
    },
    "consequence_status": {
      "enum": [
        "OBSERVED",
        "PARTIALLY_OBSERVED",
        "FAILED",
        "NOT_ESTABLISHED",
        "NOT_APPLICABLE"
      ]
    },
    "observed_effect": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "observer_identity": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "canonicalisation_profile": {
      "type": "string",
      "minLength": 1
    },
    "hash_algorithm": {
      "type": "string",
      "minLength": 1
    },
    "consequence_hash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "consequence_id",
    "execution_reference",
    "contemplated_effect",
    "consequence_status",
    "observed_effect",
    "observed_at",
    "evidence_references",
    "observer_identity",
    "claim_ceiling",
    "provenance"
  ],
  "additionalProperties": true
}