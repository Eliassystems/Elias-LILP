{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elias:lilp:schema:determination:v0.1",
  "title": "ELIAS LILP Determination Object v0.1",
  "description": "Working reference structural schema for a bounded LILP governance determination. Determination remains distinct from execution.",
  "type": "object",
  "x-elias-document-id": "ELIAS-LILP-SCHEMA-001",
  "x-elias-object": "DETERMINATION",
  "x-elias-schema-version": "v0.1",
  "x-elias-ancestors": {
    "std001_sha256": "076EE05F6441EA1A41F30006614AB0343E66E809A000B7509BDFF0CF729F5537",
    "man001_sha256": "429BD91C06933FD21068C51D64ECE4D299C5B33A9F22DA1E2F3572302EADBEB2",
    "lex001_sha256": "144EFB9CAAB7A0F0537A84704626AC58C5659A0B50F92AA64086B07918E63488"
  },
  "x-elias-authority-boundary": "ALLOW does not equal execution. Structural outcomes remain distinct from governance determinations.",
  "properties": {
    "object_type": {
      "const": "DETERMINATION"
    },
    "schema_id": {
      "const": "urn:elias:lilp:schema:determination:v0.1"
    },
    "schema_version": {
      "const": "v0.1"
    },
    "determination_id": {
      "type": "string",
      "minLength": 1
    },
    "governing_state_reference": {
      "type": "string",
      "minLength": 1
    },
    "governing_state_hash": {
      "type": "string",
      "minLength": 1
    },
    "contemplated_effect": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      ]
    },
    "result": {
      "enum": [
        "ALLOW",
        "HOLD",
        "DENY",
        "ESCALATE"
      ]
    },
    "structural_state": {
      "oneOf": [
        {
          "enum": [
            "NOT_ESTABLISHED",
            "INVALID",
            "NEW_CHAIN_REQUIRED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "determined_at": {
      "type": "string",
      "format": "date-time"
    },
    "determiner_identity": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "canonicalisation_profile": {
      "type": "string",
      "minLength": 1
    },
    "hash_algorithm": {
      "type": "string",
      "minLength": 1
    },
    "determination_hash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "determination_id",
    "governing_state_reference",
    "governing_state_hash",
    "contemplated_effect",
    "result",
    "structural_state",
    "reason_codes",
    "evidence_references",
    "determined_at",
    "determiner_identity",
    "scope",
    "claim_ceiling"
  ],
  "additionalProperties": true
}