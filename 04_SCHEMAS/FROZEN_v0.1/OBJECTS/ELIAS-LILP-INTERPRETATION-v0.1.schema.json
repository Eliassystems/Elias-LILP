{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elias:lilp:schema:interpretation:v0.1",
  "title": "ELIAS LILP Interpretation Object v0.1",
  "description": "Working reference structural schema for an interpretation derived from separately preserved evidence. Interpretation must not silently replace the source observation.",
  "type": "object",
  "x-elias-document-id": "ELIAS-LILP-SCHEMA-001",
  "x-elias-object": "INTERPRETATION",
  "x-elias-schema-version": "v0.1",
  "x-elias-ancestors": {
    "std001_sha256": "076EE05F6441EA1A41F30006614AB0343E66E809A000B7509BDFF0CF729F5537",
    "man001_sha256": "429BD91C06933FD21068C51D64ECE4D299C5B33A9F22DA1E2F3572302EADBEB2",
    "lex001_sha256": "144EFB9CAAB7A0F0537A84704626AC58C5659A0B50F92AA64086B07918E63488"
  },
  "x-elias-authority-boundary": "Observation does not equal interpretation. The frozen normative standard controls.",
  "properties": {
    "object_type": {
      "const": "INTERPRETATION"
    },
    "schema_id": {
      "const": "urn:elias:lilp:schema:interpretation:v0.1"
    },
    "schema_version": {
      "const": "v0.1"
    },
    "interpretation_id": {
      "type": "string",
      "minLength": 1
    },
    "source_evidence_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interpreter_identity": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      ]
    },
    "interpreted_at": {
      "type": "string",
      "format": "date-time"
    },
    "interpretation": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "canonicalisation_profile": {
      "type": "string",
      "minLength": 1
    },
    "hash_algorithm": {
      "type": "string",
      "minLength": 1
    },
    "interpretation_hash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "interpretation_id",
    "source_evidence_references",
    "interpreter_identity",
    "interpreted_at",
    "interpretation",
    "scope",
    "provenance"
  ],
  "additionalProperties": true
}