{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elias:lilp:schema:conformance-result:v0.1",
  "title": "ELIAS LILP Conformance Result Object v0.1",
  "description": "Working reference structural schema for a bounded conformance examination result. A conformance result is limited to its declared scope and evidence and does not equal external certification.",
  "type": "object",
  "x-elias-document-id": "ELIAS-LILP-SCHEMA-001",
  "x-elias-object": "CONFORMANCE_RESULT",
  "x-elias-schema-version": "v0.1",
  "x-elias-ancestors": {
    "std001_sha256": "076EE05F6441EA1A41F30006614AB0343E66E809A000B7509BDFF0CF729F5537",
    "man001_sha256": "429BD91C06933FD21068C51D64ECE4D299C5B33A9F22DA1E2F3572302EADBEB2",
    "lex001_sha256": "144EFB9CAAB7A0F0537A84704626AC58C5659A0B50F92AA64086B07918E63488"
  },
  "x-elias-authority-boundary": "A bounded conformance result does not establish external certification, regulatory approval or universal correctness.",
  "properties": {
    "object_type": {
      "const": "CONFORMANCE_RESULT"
    },
    "schema_id": {
      "const": "urn:elias:lilp:schema:conformance-result:v0.1"
    },
    "schema_version": {
      "const": "v0.1"
    },
    "conformance_result_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_reference": {
      "type": "string",
      "minLength": 1
    },
    "subject_hash": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "standard_reference": {
      "type": "string",
      "minLength": 1
    },
    "standard_hash": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "HOLD",
        "NOT_ESTABLISHED",
        "NOT_APPLICABLE"
      ]
    },
    "tested_requirement_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "failed_requirement_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "not_established_requirement_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evaluator_identity": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      ]
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "canonicalisation_profile": {
      "type": "string",
      "minLength": 1
    },
    "hash_algorithm": {
      "type": "string",
      "minLength": 1
    },
    "conformance_result_hash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "conformance_result_id",
    "subject_reference",
    "subject_hash",
    "standard_reference",
    "standard_hash",
    "scope",
    "result",
    "tested_requirement_references",
    "failed_requirement_references",
    "not_established_requirement_references",
    "evidence_references",
    "evaluated_at",
    "evaluator_identity",
    "claim_ceiling",
    "provenance"
  ],
  "additionalProperties": true
}