    "lex001_sha256": "144EFB9CAAB7A0F0537A84704626AC58C5659A0B50F92AA64086B07918E63488"
  },
  "x-elias-authority-boundary": "Mandatory FAILED or NOT_ESTABLISHED predicates must not silently become permission. The frozen normative standard controls.",
  "properties": {
