          "enum": [
            "ESTABLISHED",
            "FAILED",
            "NOT_ESTABLISHED"
          ]
        },
        "evidence": {
          "enum": [
            "ESTABLISHED",
            "FAILED",
            "NOT_ESTABLISHED"
          ]
        },
        "policy": {
          "enum": [
            "ESTABLISHED",
            "FAILED",
            "NOT_ESTABLISHED"
          ]
        },
        "scope": {
          "enum": [
            "ESTABLISHED",
            "FAILED",
            "NOT_ESTABLISHED"
          ]
        },
        "jurisdiction": {
          "enum": [
            "ESTABLISHED",
            "FAILED",
            "NOT_ESTABLISHED"
          ]
        },
        "temporal_validity": {
          "enum": [
            "ESTABLISHED",
            "FAILED",
            "NOT_ESTABLISHED"
          ]
        },
        "contemplated_effect_alignment": {
          "enum": [
            "ESTABLISHED",
            "FAILED",
            "NOT_ESTABLISHED"
          ]
